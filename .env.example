# LLM
ZAI_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=GLM-5.3-Flash

# Browser / worker
# REPETIT_CDP_PORT=9335
# REPETIT_CHROME_NO_LAUNCH=0
# REPETIT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# REPETIT_CHROME_PROFILE=data/chrome-profiles/main
# REPETIT_DB=data/repetit.db
# REPETIT_LOG_TAG=
# REPETIT_DAILY_SEND_LIMIT=0      # 0 = unlimited
# REPETIT_MAX_PER_CYCLE=3
# REPETIT_WORK_HOURS=8,23         # 0,24 only for explicit 24/7
# REPETIT_MIN_CLIENT_RATE=0       # minimum known client budget RUB/60 min; 0 = off
# REPETIT_SUBJECTS=информатик,программирован
# REPETIT_STOP_PATTERNS=c++,с++,олимпиад
# REPETIT_PERSONA=maxim
# REPETIT_LOG_LEVEL=INFO

# First-message fallback
# Enabled by default. Used only after hard filters and only when LLM is unavailable/unusable.
# A normal LLM skip never uses fallback.
# REPETIT_FALLBACK_ENABLED=1
# Optional templates separated by ||. Empty = built-in safe templates.
# REPETIT_FALLBACK_TEMPLATES=Здравствуйте! ...||Добрый день! ...

# Existing-chat auto replies
# OFF by default until a live `repetit chats-once --dry-run` sender-shape canary is checked.
# REPETIT_CHAT_AUTO=0
# REPETIT_CHAT_EVERY_CYCLES=3
# REPETIT_CHAT_MAX_PER_CYCLE=2
# REPETIT_CHAT_SCAN_LIMIT=6
# REPETIT_CHAT_MAX_ORDER_AGE_DAYS=14
